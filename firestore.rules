rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document by path userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document rules: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User transactions collection: /users/{userId}/transactions/{transactionId}
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      // User budgets collection: /users/{userId}/budgets/{budgetId}
      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Root-level transactions collection (if used directly with userId field)
    match /transactions/{transactionId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Root-level budgets collection (if used directly with userId field)
    match /budgets/{budgetId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
